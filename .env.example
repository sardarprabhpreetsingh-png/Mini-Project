# SpeakSense Backend Configuration

# Google Gemini API Key for Generative AI Speech Coaching
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini model (e.g., gemini-3.8-flash or gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Whisper STT model size: 'tiny', 'base', 'small', 'medium'
# 'tiny' is recommended for fast responsiveness and mini-project demos
WHISPER_MODEL=tiny

# Maximum uploaded audio file size in megabytes (default: 25)
MAX_FILE_SIZE_MB=25

# Backend Port
PORT=8000
